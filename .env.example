# ─── Application ───────────────────────────────────────────
APP_NAME="Laravel CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# ─── Database (must match docker-compose.yml) ───────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_crm
DB_USERNAME=crm_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_HERE
# ─── Session & Cache ───────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ─── Mail (configure your SMTP provider) ───────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# ─── Laravel CRM ───────────────────────────────────────────
LARAVEL_CRM_OWNER=admin
LARAVEL_CRM_CURRENCY=COP
LARAVEL_CRM_COUNTRY=Colombia
LARAVEL_CRM_LANGUAGE=english
LARAVEL_CRM_TIMEZONE=America/Bogota
LARAVEL_CRM_DATE_FORMAT=Y-m-d
LARAVEL_CRM_TIME_FORMAT="g:i A"
LARAVEL_CRM_USER_INTERFACE=true
# ─── Docker DB Root Password (must match docker-compose.yml) ─
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE
# ─── Vite ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
